{
  "editor.fontSize": 14,
  "editor.fontFamily": "Consolas, 'Courier New', monospace",
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.lineNumbers": "on",
  "editor.minimap": true,
  "editor.cursorBlinking": "smooth",
  "editor.bracketPairColorization": true,
  "editor.formatOnSave": true,
  "workbench.colorTheme": "dark-modern",
  "workbench.iconTheme": "vs-seti",
  "workbench.layoutDensity": "comfortable",
  "workbench.statusBarVisible": true,
  "workbench.zenMode": false,
  "terminal.fontSize": 13,
  "terminal.cursorStyle": "line",
  "selenium.defaultSpeed": "normal",
  "selenium.autoOpenPreview": true,
  "selenium.highlightColor": "#00f2fe",
  "selenium.autoGenerateTests": true,
  "selenium.healthThreshold": 85,
  "ai.model": "gemini-2.5-flash",
  "ai.autoContext": true,
  "ai.inlineSuggestions": true
}

